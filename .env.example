# Application
PORT=3000

# MySQL / MariaDB connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=practica_node

# Prisma connection string (used by prisma CLI / migrations)
DATABASE_URL="mysql://root:your_password@localhost:3306/practica_node"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1h
